# ──────────────────────────────────────────────────────────────────────
# Nothing outside public/ is served as a file.
#
# Sir Peter, 22 October, after a video claiming a PHP flaw puts most sites at
# risk: "can you fix any lose ends or issues before we go live". The video is a
# thumbnail with a number on it. Checking the live site properly found
# something real, and this is it.
#
# The document root on this host IS the Laravel root, with index.php at the top
# including the application. The rewrite below only sends a request to the
# front controller when no actual file matches it -- so every real file in the
# project was being served to anybody who asked for its path:
#
#   /storage/logs/laravel.log   1.4 MB of errors, 7,040 full server paths,
#                               stack traces, user ids and email addresses,
#                               from 30 April to 19 September
#   /composer.lock              the exact version of every package, which is a
#                               list of which published vulnerabilities apply
#   /composer.json, /artisan, /vendor/autoload.php
#
# .env and .git were already refused, which is what made this look covered.
# They were refused one path at a time; everything nobody thought to name was
# open.
#
# Assets are served from /public/... on this host (/public/gigresource-logos,
# /public/storage/...), so that prefix is deliberately exempt. Blocking it
# would take the whole site's images with it.
# ──────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ONLY WHEN A REAL FILE IS THERE. This condition is the whole correctness
    # of the block below, and leaving it out took the site down.
    #
    # The first version of these rules matched on the URL alone. The admin
    # dashboard lived under /app/users, /app/admin/... and so on, the same
    # first path segment as the app/ source directory, so 135 routes started
    # answering 403 from the web server. The application never saw them.
    #
    # Those pages moved to /admin on 27 October, which takes the admin portal
    # out of this rule's way for good. The condition still matters: /app
    # remains the address of the agreements, bookings, chat, events,
    # membership-plan and payment pages, which clients and professionals use.
    #
    # A source file exists on disk and is refused. A route does not exist on
    # disk and falls through to the front controller, which is what the rewrite
    # at the bottom of this file is for. Directory listings are already off
    # through Options -Indexes.

    # The application's own directories, unless the path is a public asset.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules|docs)/ - [F,L]

    # Files that sit at the top of the project and describe how it is built.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml(\.dist)?|vite\.config\.js|postcss\.config\.js|tailwind\.config\.js)$ - [F,L]

    # Working files by extension. Exempt under /public/ as well: a client's
    # uploaded PDF lives there, and blocking the extension outright would stop
    # people downloading their own documents.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule \.(md|sh|sql|ya?ml|lock|bak|old|orig|save|swp|dist)$ - [F,L]
</IfModule>

# Dotfiles, and the same refusal again without mod_rewrite, because a server
# that loses a module should fail closed rather than start serving .env.
<FilesMatch "^\.|^(artisan|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
